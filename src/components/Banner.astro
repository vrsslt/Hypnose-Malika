---
import { Image } from "astro:assets";
import banner from "../assets/banner.webp";
---

<section class="banner">
  <Image
    class="banner-img"
    src={banner}
    alt=""
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="banner-content">
    <p class="eyebrow">Hypnose quantique, spirituelle et énergétique</p>
    <h1>Retrouvez votre <br/>équilibre</h1>
    <a class="cta" href="/#contact">Prendre rendez-vous</a>
  </div>
  <a class="scroll-cue" href="#about" aria-label="Découvrir la suite">
    <span></span>
  </a>
</section>

<style>
  .banner {
    position: relative;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) 0 4.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: var(--color-primary);
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 66% 40%;
  }

  /* voile pour la lisibilité du texte */
  .banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(31, 62, 75, 0.55) 0, rgba(31, 62, 75, 0) 9rem),
      linear-gradient(
        90deg,
        rgba(31, 62, 75, 0.78) 0%,
        rgba(31, 62, 75, 0.5) 50%,
        rgba(31, 62, 75, 0) 85%
      );
  }

  .banner-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.25rem;
    color: var(--color-white);
  }

  .eyebrow {
    max-width: 16rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .banner h1 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(3rem, 2rem + 5vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: var(--color-white);
    text-shadow: 0 2px 20px rgba(31, 62, 75, 0.35);
  }

  .cta {
    display: inline-block;
    margin-top: 1.75rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.4s, transform 0.4s var(--ease-calm);
  }

  .cta:hover {
    background-color: var(--color-white);
    transform: translateY(-2px);
  }

  .cta:focus-visible,
  .scroll-cue:focus-visible {
    outline-color: var(--color-white);
  }

  /* invitation à défiler */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    z-index: 1;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .scroll-cue span {
    width: 0.9rem;
    height: 0.9rem;
    margin-bottom: 0.4rem;
    border-right: 2px solid var(--color-white);
    border-bottom: 2px solid var(--color-white);
    transform: rotate(45deg);
    opacity: 0.85;
  }

  @media (min-width: 768px) {
    .banner-img {
      object-position: 74% 30%;
    }

    .eyebrow {
      max-width: none;
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* lente dérive de l'image, comme une respiration */
    .banner-img {
      animation: drift 28s ease-in-out infinite alternate;
    }

    .eyebrow,
    .banner h1,
    .cta {
      animation: rise 1.4s var(--ease-calm) both;
    }

    .banner h1 {
      animation-delay: 0.25s;
    }

    .scroll-cue {
      animation: float 3.5s ease-in-out infinite;
    }

    /* halo qui pulse au rythme d'une respiration lente */
    .cta {
      animation:
        rise 1.4s var(--ease-calm) 0.5s both,
        breathe 6s ease-in-out 2s infinite;
    }
  }

  @keyframes drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  @keyframes float {
    50% {
      transform: translateY(0.4rem);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(224, 176, 112, 0.45);
    }
    50% {
      box-shadow: 0 0 0 14px rgba(224, 176, 112, 0);
    }
  }
</style>
