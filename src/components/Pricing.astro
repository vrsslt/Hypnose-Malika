---
import Lotus from "./Lotus.astro";
---

<section id="seance" class="seance section">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Déroulement d’une séance</h2>
      <Lotus />
    </div>
    <div class="seance-cards">
      <div class="card" data-reveal>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 3h12M6 21h12M7 3v3a5 5 0 0 0 2 4l3 2 3-2a5 5 0 0 0 2-4V3M7 21v-3a5 5 0 0 1 2-4l3-2 3 2a5 5 0 0 1 2 4v3"/>
        </svg>
        <h3>Durée</h3>
        <p>2 à 4 heures</p>
      </div>
      <div class="card" data-reveal style="--i: 1">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6.500A7 7 0 0 0 7 12a7 7 0 0 0 11 5.500M4 10.500h9M4 13.500h9"/>
        </svg>
        <h3>Tarif</h3>
        <p>160 €</p>
      </div>
      <div class="card" data-reveal style="--i: 2">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 11.500 12 4l9 7.500M5.500 10v10h13V10M10 20v-6h4v6"/>
        </svg>
        <h3>Lieu</h3>
        <p>À domicile</p>
      </div>
      <div class="card" data-reveal style="--i: 3">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.500A8.500 8.500 0 0 1 9.500 4 8.500 8.500 0 1 0 20 14.500z"/>
        </svg>
        <h3>Après la séance</h3>
        <p class="small">Ne rien prévoir pour prolonger l’état de détente</p>
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    color: var(--color-dark-blue);
  }

  .seance-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 1.5rem 1rem;
    text-align: center;
    background-color: var(--color-sand-light);
    border-radius: var(--radius);
  }

  .icon {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.5rem;
    fill: none;
    stroke: var(--color-dark-blue);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card h3 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brown);
  }

  .card p {
    font-family: var(--font-title);
    font-size: clamp(1.3rem, 1rem + 1.6vw, 1.6rem);
    line-height: 1.25;
    color: var(--color-dark-blue);
  }

  .card p.small {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .seance-cards {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
</style>
