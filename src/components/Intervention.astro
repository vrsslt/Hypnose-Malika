---
import { Image } from "astro:assets";
import meditation from "../assets/meditation.webp";
import Lotus from "./Lotus.astro";

const domaines = [
	"Apaiser les blessures d’évènements passés encore présents",
	"Rencontrer et réconforter son enfant intérieur",
	"Entrer en dialogue avec une émotion, une douleur, un blocage ou une présence subtile",
	"Recevoir un soin énergétique réharmonisant",
	"Se relier à son guide, à sa conscience supérieure ou à un proche disparu",
	"Éclairer sa mission de vie et trouver clarté dans ses choix",
	"Se ressourcer dans des espaces intérieurs de lumière et de paix",
	"Explorer les mémoires de vies antérieures",
];
---

<section id="intervention" class="intervention section section--sand">
  <div class="container">
    <div class="section-head" data-reveal>
      <h2>Mes domaines d'intervention</h2>
      <Lotus />
    </div>
    <div class="content-container">
      <Image
        src={meditation}
        alt="illustration d'une femme méditant en pleine nature"
        widths={[400, 760]}
        sizes="(min-width: 900px) 360px, 400px"
        data-reveal
      />
      <ul>
        {domaines.map((domaine, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <Lotus size={22} />
            <span>{domaine}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .section-head {
    color: var(--color-primary);
  }

  .content-container {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .intervention img {
    display: block;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  .intervention ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .intervention li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.1rem;
    background-color: var(--color-white);
    border-radius: 1rem;
    color: var(--color-primary);
    font-weight: 500;
    line-height: 1.45;
  }

  @media (min-width: 640px) {
    .intervention ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .content-container {
      grid-template-columns: 360px 1fr;
      gap: 3rem;
    }
  }
</style>
