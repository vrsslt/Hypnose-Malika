---
import Lotus from "./Lotus.astro";

// overlay : header transparent tant qu'on est en haut de la bannière
const { overlay = false } = Astro.props;
---

<header id="site-header" class:list={[{ overlay }]}>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Hypnose Malika, retour à l'accueil">
      <Lotus size={40} />
      <span>Hypnose Malika</span>
    </a>
    <div class="header-actions">
      <a class="header-cta" href="/#contact" aria-label="Prendre rendez-vous">RDV</a>
      <button id="burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <nav id="nav-menu" class="nav-menu" aria-label="Navigation principale">
      <ul>
        <li><a href="/#about">Mon chemin</a></li>
        <li><a href="/#intervention">Domaines</a></li>
        <li><a href="/#seance">Séance</a></li>
        <li><a href="/#FAQ">FAQ</a></li>
        <li><a class="nav-cta" href="/#contact">Prendre RDV</a></li>
      </ul>
    </nav>
  </div>
  <div id="nav-backdrop" class="nav-backdrop"></div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-h);
    background-color: rgba(47, 88, 104, 0.92);
    backdrop-filter: blur(10px);
    color: var(--color-white);
    box-shadow: 0 2px 16px rgba(31, 62, 75, 0.18);
    z-index: 1000;
    transition: background-color 0.6s, box-shadow 0.6s;
  }

  /* en haut de la bannière : la photo passe sous le header */
  :global(.js) header.overlay:not(.scrolled):not(.menu-open) {
    background-color: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }

  .header-inner {
    max-width: 1200px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-title);
    font-weight: 700;
    font-size: clamp(1.6rem, 7.5vw, 2rem);
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* raccourci rendez-vous, une fois la bannière passée */
  .header-cta {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.5s, transform 0.5s var(--ease-calm), visibility 0s;
  }

  :global(.js) header:not(.past-hero) .header-cta {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.4rem);
    transition: opacity 0.5s, transform 0.5s var(--ease-calm), visibility 0s 0.5s;
  }

  .header-cta:focus-visible {
    outline-color: var(--color-white);
  }

  @media (max-width: 349px) {
    .header-cta {
      display: none;
    }
  }

  /* burger */
  #burger {
    position: relative;
    z-index: 2;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  #burger span {
    display: block;
    height: 2px;
    width: 24px;
    background-color: var(--color-white);
    border-radius: 2px;
    transition: transform 0.4s var(--ease-calm), opacity 0.3s;
  }

  #burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  #burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  #burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  #burger:focus-visible,
  .brand:focus-visible,
  .nav-menu a:focus-visible {
    outline-color: var(--color-white);
  }

  /* nav mobile */
  .nav-menu {
    position: fixed;
    top: var(--header-h);
    right: 0;
    width: min(20rem, 85vw);
    height: calc(100dvh - var(--header-h));
    background-color: var(--color-primary);
    border-radius: 0 0 0 var(--radius);
    box-shadow: -8px 12px 30px rgba(31, 62, 75, 0.3);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.5s var(--ease-calm), visibility 0s 0.5s;
    overflow-y: auto;
    z-index: 1;
  }

  .nav-menu.open {
    transform: none;
    visibility: visible;
    transition: transform 0.5s var(--ease-calm), visibility 0s;
  }

  .nav-menu ul {
    list-style: none;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-menu a {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    color: var(--color-white);
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.3s, color 0.3s;
  }

  .nav-menu a:hover {
    background-color: rgba(251, 247, 240, 0.12);
  }

  .nav-menu .nav-cta {
    margin-top: 0.75rem;
    text-align: center;
    background-color: var(--color-accent);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .nav-menu .nav-cta:hover {
    background-color: var(--color-white);
  }

  .nav-backdrop {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    height: calc(100dvh - var(--header-h));
    background-color: rgba(31, 62, 75, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s, visibility 0s 0.5s;
  }

  .nav-backdrop.open {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s, visibility 0s;
  }

  /* --- Desktop --- */
  @media (min-width: 900px) {
    .header-actions,
    .nav-backdrop {
      display: none;
    }

    .nav-menu {
      position: static;
      width: auto;
      height: auto;
      background: none;
      box-shadow: none;
      transform: none;
      visibility: visible;
      overflow: visible;
    }

    .nav-menu ul {
      flex-direction: row;
      align-items: center;
      gap: 0.25rem;
      padding: 0;
    }

    .nav-menu a {
      padding: 0.5rem 0.9rem;
      font-size: 1rem;
      white-space: nowrap;
    }

    .nav-menu .nav-cta {
      margin: 0 0 0 0.5rem;
      padding: 0.5rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header,
    .header-cta,
    .nav-menu,
    .nav-backdrop,
    #burger span {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const hero = document.querySelector<HTMLElement>(".banner");
  const burger = document.getElementById("burger");
  const menu = document.getElementById("nav-menu");
  const backdrop = document.getElementById("nav-backdrop");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("open", open);
    backdrop?.classList.toggle("open", open);
    burger?.setAttribute("aria-expanded", String(open));
    header?.classList.toggle("menu-open", open);
  };

  const onScroll = () => {
    if (!header) return;
    const heroEnd = hero ? hero.offsetHeight - header.offsetHeight : 0;
    header.classList.toggle("scrolled", window.scrollY > 16);
    header.classList.toggle("past-hero", window.scrollY >= heroEnd);
  };

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);

  burger?.addEventListener("click", () => {
    setOpen(burger.getAttribute("aria-expanded") !== "true");
  });

  backdrop?.addEventListener("click", () => setOpen(false));

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && burger?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      burger.focus();
    }
  });
</script>
